# ── LLM API 配置 ──
SILICON_API_KEY=你的API_KEY
SILICON_BASE_URL=https://api.deepseek.com
SILICON_MODEL=deepseek-chat

# ── Embedding API 配置（OpenAI 兼容接口，当前供应商：智谱）──
# 变量名与供应商无关：换供应商只改这三行；换供应商/模型 = 换向量空间，
# 必须全量重建知识库（python -m app.rebuild_kb）
EMBEDDING_API_KEY=你的API_KEY
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ── 邮件 SMTP 配置（可选，使用邮件发送功能时需要）──
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=你的QQ号@qq.com
SMTP_PASSWORD=QQ邮箱授权码

# ── Redis 配置（可选）──
# REDIS_PASSWORD=你的密码

# ── 其他可选配置 ──
# RABBITMQ_PASSWORD=123456
# JWT_SECRET=换成随机长字符串（未配置时使用默认演示密钥）
